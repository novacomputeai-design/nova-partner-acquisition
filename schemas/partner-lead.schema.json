{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nova Partner Acquisition Lead",
  "type": "object",
  "required": [
    "record_version",
    "segment",
    "account",
    "opportunity",
    "contact_status",
    "outreach_status",
    "gates",
    "next_action",
    "contact",
    "cross_segment_history_checked",
    "suppression_checked",
    "sender_ready",
    "compliance_ready",
    "approval_refs",
    "message_packet",
    "send_evidence"
  ],
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "segment": {
      "const": "COMMERCIAL_PARTNER"
    },
    "account": {
      "type": "object",
      "required": [
        "account_key",
        "company",
        "source_url",
        "checked_at"
      ],
      "properties": {
        "account_key": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "minLength": 1
        },
        "legal_identity_status": {
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "UNKNOWN",
            "CONFLICT"
          ]
        }
      },
      "additionalProperties": false
    },
    "opportunity": {
      "type": "object",
      "required": [
        "category",
        "evidence",
        "verdict",
        "hypothesis"
      ],
      "properties": {
        "category": {
          "enum": [
            "EXPLORATORY_PARTNER",
            "SIGNAL_ANCHORED",
            "BUYER_CONFIRMED"
          ]
        },
        "evidence": {
          "enum": [
            "VERIFIED_FACT",
            "PUBLIC_SIGNAL",
            "PARTNERSHIP_HYPOTHESIS",
            "BUYER_CONFIRMED",
            "UNKNOWN",
            "CONFLICT"
          ]
        },
        "fit_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "verdict": {
          "enum": [
            "PRIORITIZE",
            "RESEARCH",
            "DEPRIORITIZE",
            "HOLD"
          ]
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "contact_status": {
      "enum": [
        "DELIVERY_DECISION_CONTACT",
        "PROFESSIONAL_REFERRAL_CONTACT",
        "RESEARCH_ONLY",
        "DO_NOT_CONTACT"
      ]
    },
    "contact": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "person_key": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "business_route_status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "UNAVAILABLE"
          ]
        },
        "history_status": {
          "enum": [
            "CLEAR",
            "EXISTING",
            "UNKNOWN",
            "SUPPRESSED",
            "CONFLICT"
          ]
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "employer": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "person_key",
        "employer",
        "role",
        "verified_at",
        "business_route_status",
        "history_status"
      ]
    },
    "outreach_status": {
      "enum": [
        "NOT_DRAFTED",
        "DRAFTED",
        "GATE_A_APPROVED",
        "DISPATCH_AUTHORIZED",
        "SEND_ATTEMPTED",
        "SENT_CONFIRMED",
        "SEND_UNCERTAIN",
        "SEND_FAILED",
        "HOLD"
      ]
    },
    "gates": {
      "type": "object",
      "required": [
        "r0",
        "gate_a",
        "dispatch",
        "gate_b"
      ],
      "properties": {
        "r0": {
          "enum": [
            "NOT_ASSESSED",
            "READY_FOR_REVIEW",
            "APPROVED",
            "HOLD"
          ]
        },
        "gate_a": {
          "enum": [
            "NOT_ASSESSED",
            "READY_FOR_REVIEW",
            "APPROVED",
            "HOLD"
          ]
        },
        "dispatch": {
          "enum": [
            "NOT_ASSESSED",
            "READY_FOR_REVIEW",
            "APPROVED",
            "HOLD"
          ]
        },
        "gate_b": {
          "enum": [
            "NOT_ASSESSED",
            "READY_FOR_REVIEW",
            "APPROVED",
            "HOLD"
          ]
        }
      },
      "additionalProperties": false
    },
    "cross_segment_history_checked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "suppression_checked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "sender_ready": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "compliance_ready": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "approval_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r0",
        "gate_a",
        "dispatch",
        "gate_b"
      ],
      "properties": {
        "r0": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "gate_a": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dispatch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "gate_b": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "message_packet": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "sender",
        "recipient",
        "subject",
        "body",
        "fingerprint"
      ],
      "properties": {
        "sender": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "send_evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "provider_message_id",
        "sent_at",
        "message_fingerprint"
      ],
      "properties": {
        "provider_message_id": {
          "type": "string",
          "minLength": 1
        },
        "sent_at": {
          "type": "string",
          "minLength": 1
        },
        "message_fingerprint": {
          "type": "string",
          "minLength": 16
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outreach_status": {
            "enum": [
              "GATE_A_APPROVED",
              "DISPATCH_AUTHORIZED",
              "SEND_ATTEMPTED",
              "SENT_CONFIRMED"
            ]
          }
        },
        "required": [
          "outreach_status"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "gates": {
                "properties": {
                  "r0": {
                    "const": "APPROVED"
                  },
                  "gate_a": {
                    "const": "APPROVED"
                  }
                },
                "required": [
                  "r0",
                  "gate_a"
                ]
              },
              "approval_refs": {
                "properties": {
                  "r0": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gate_a": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "r0",
                  "gate_a"
                ]
              }
            },
            "required": [
              "gates",
              "approval_refs"
            ]
          },
          {
            "properties": {
              "contact": {
                "type": "object",
                "properties": {
                  "business_route_status": {
                    "const": "VERIFIED"
                  }
                },
                "required": [
                  "business_route_status"
                ]
              },
              "message_packet": {
                "type": "object"
              },
              "cross_segment_history_checked": {
                "const": true
              },
              "suppression_checked": {
                "const": true
              }
            },
            "required": [
              "contact",
              "message_packet",
              "cross_segment_history_checked",
              "suppression_checked"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outreach_status": {
            "enum": [
              "DISPATCH_AUTHORIZED",
              "SEND_ATTEMPTED",
              "SENT_CONFIRMED"
            ]
          }
        },
        "required": [
          "outreach_status"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "gates": {
                "properties": {
                  "dispatch": {
                    "const": "APPROVED"
                  }
                },
                "required": [
                  "dispatch"
                ]
              },
              "approval_refs": {
                "properties": {
                  "dispatch": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "dispatch"
                ]
              }
            },
            "required": [
              "gates",
              "approval_refs"
            ]
          },
          {
            "properties": {
              "sender_ready": {
                "const": true
              }
            },
            "required": [
              "sender_ready"
            ]
          },
          {
            "properties": {
              "compliance_ready": {
                "const": true
              }
            },
            "required": [
              "compliance_ready"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outreach_status": {
            "const": "SENT_CONFIRMED"
          }
        },
        "required": [
          "outreach_status"
        ]
      },
      "then": {
        "properties": {
          "send_evidence": {
            "type": "object"
          }
        },
        "required": [
          "send_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "opportunity": {
            "type": "object",
            "properties": {
              "category": {
                "const": "BUYER_CONFIRMED"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        "required": [
          "opportunity"
        ]
      },
      "then": {
        "properties": {
          "opportunity": {
            "properties": {
              "evidence": {
                "const": "BUYER_CONFIRMED"
              }
            },
            "required": [
              "evidence"
            ]
          }
        }
      }
    }
  ]
}
